From 11643f0f4fa45a99cdeb62c0289e116bfa7f939c Mon Sep 17 00:00:00 2001
From: Leah Rowe <leah@libreboot.org>
Date: Tue, 6 Oct 2026 08:29:49 +0100
Subject: [PATCH 1/1] remove build -Werrors

Signed-off-by: Leah Rowe <leah@libreboot.org>
---
 Makefile           | 2 +-
 tests/gen_tests.py | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/Makefile b/Makefile
index d6fe5aa..7c9235e 100644
--- a/Makefile
+++ b/Makefile
@@ -50,7 +50,7 @@ else
 endif
 
 # --- Warning flags ---
-WARN_FLAGS := -pedantic -Wall -Wextra -Wundef -Werror
+WARN_FLAGS := -pedantic -Wall -Wextra -Wundef
 
 ifneq ($(IS_CLANG),)
   WARN_FLAGS += -Weverything
diff --git a/tests/gen_tests.py b/tests/gen_tests.py
index d2996e2..2b05e7d 100644
--- a/tests/gen_tests.py
+++ b/tests/gen_tests.py
@@ -178,14 +178,14 @@ def write_makefile(
     )
 
     c_cflags = (
-        f"-Os -std=c17 -Wall -Wextra -Wundef -Werror "
+        f"-Os -std=c17 -Wall -Wextra -Wundef "
         f"{common_warn} -Wno-missing-prototypes "
         f"-I{include_rel} -I{test_rel} "
         f"{arch_flag} {san_flags} {extra_cflags}".rstrip()
     )
 
     cxx_cflags = (
-        f"-Os -std=c++20 -Wall -Wextra -Wundef -Werror "
+        f"-Os -std=c++20 -Wall -Wextra -Wundef "
         f"{common_warn} "
         f"-Wno-old-style-cast -Wno-zero-as-null-pointer-constant "
         f"-I{include_rel} -I{test_rel} "
-- 
2.47.3

