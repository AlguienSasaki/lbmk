+
+clean:
+	make clean
+
+distclean:
+	make clean
+
+oldconfig:
+	:
+
+menuconfig:
+	:
+
+savedefconfig:
+	:
+
+olddefconfig:
+	:
+
+nconfig:
+	:
+
