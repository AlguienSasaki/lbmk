From 21b62ec1262cfe4f32dc9ead44cb0fa7e3a8b5d6 Mon Sep 17 00:00:00 2001
From: Leah Rowe <leah@libreboot.org>
Date: Wed, 7 Oct 2026 21:54:39 +0100
Subject: [PATCH 1/1] don't add gop driver on haswell/broadwell

in libreboot, we will use libgfxinit exclusively

Signed-off-by: Leah Rowe <leah@libreboot.org>
---
 3rdparty/libgfxinit | 2 +-
 3rdparty/vboot      | 2 +-
 site-local/Kconfig  | 1 -
 3 files changed, 2 insertions(+), 3 deletions(-)

diff --git a/3rdparty/libgfxinit b/3rdparty/libgfxinit
index 6e74c70313..629744a088 160000
--- a/3rdparty/libgfxinit
+++ b/3rdparty/libgfxinit
@@ -1 +1 @@
-Subproject commit 6e74c703132a8b4af4354a5158f286dc8f2407ab
+Subproject commit 629744a088a0a1820d87e2719f6a4fcf74d8fabf
diff --git a/3rdparty/vboot b/3rdparty/vboot
index 5c360ef458..9f06423465 160000
--- a/3rdparty/vboot
+++ b/3rdparty/vboot
@@ -1 +1 @@
-Subproject commit 5c360ef458b0a013d8a6d47724bb0fffb5accbcf
+Subproject commit 9f0642346551f5accf76e15789d79087ccbbac24
diff --git a/site-local/Kconfig b/site-local/Kconfig
index 04677a0df4..6201b15dac 100644
--- a/site-local/Kconfig
+++ b/site-local/Kconfig
@@ -80,7 +80,6 @@ config CBFS_SIZE
 	default 0x500000
 
 config EDK2_GOP_FILE
-	default "3rdparty/blobs/soc/intel/bdw/IntelGopDriver.efi" if NORTHBRIDGE_INTEL_HASWELL || SOC_INTEL_BROADWELL
 	default "3rdparty/blobs/soc/intel/byt/IntelGopDriver.efi" if SOC_INTEL_BAYTRAIL
 	default "3rdparty/blobs/soc/intel/bsw/IntelGopDriver.efi" if SOC_INTEL_BRASWELL
 	default "3rdparty/blobs/soc/intel/kbl/IntelGopDriver.efi" if SOC_INTEL_SKYLAKE || SOC_INTEL_KABYLAKE
-- 
2.47.3

