From 2d2b798ff47216029a4f85b6983d74ad90162da2 Mon Sep 17 00:00:00 2001
From: Leah Rowe <leah@libreboot.org>
Date: Mon, 28 Sep 2026 05:31:02 +0100
Subject: [PATCH 1/1] disable DEBUG_STACK_OVERFLOW_BREAKPOINTS by default

otherwise it shows up in lbmk configs

Signed-off-by: Leah Rowe <leah@libreboot.org>
---
 src/arch/x86/Kconfig | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/arch/x86/Kconfig b/src/arch/x86/Kconfig
index 14093089e7..be28cb0a57 100644
--- a/src/arch/x86/Kconfig
+++ b/src/arch/x86/Kconfig
@@ -379,7 +379,7 @@ config DEBUG_NULL_DEREF_BREAKPOINTS_IN_ALL_STAGES
 
 config DEBUG_STACK_OVERFLOW_BREAKPOINTS
 	bool
-	default y
+	default n
 	depends on DEBUG_HW_BREAKPOINTS
 	help
 	  Enable support for catching stack overflows
-- 
2.47.3

