From 64fed6975b2d451db954536d837adf77c590fd7d Mon Sep 17 00:00:00 2001
From: Leah Rowe <leah@libreboot.org>
Date: Mon, 5 Oct 2026 19:37:36 +0100
Subject: [PATCH 1/1] add seabios csm support

Signed-off-by: Leah Rowe <leah@libreboot.org>
---
 payloads/external/edk2/Makefile | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/payloads/external/edk2/Makefile b/payloads/external/edk2/Makefile
index 20ed01ca31..b99c2494db 100644
--- a/payloads/external/edk2/Makefile
+++ b/payloads/external/edk2/Makefile
@@ -264,9 +264,12 @@ $(EDK2_PLATFORMS_PATH): $(WORKSPACE)
 	:
 
 $(EDK2_PATH): $(WORKSPACE)
-	rm -Rf $(WORKSPACE)/mrchromebox
-	mkdir -p $(WORKSPACE)
-	cp -a edk2_src $(WORKSPACE)/mrchromebox
+	rm -Rf $(WORKSPACE)/mrchromebox; \
+	mkdir -p $(WORKSPACE); \
+	cp -a edk2_src $(WORKSPACE)/mrchromebox; \
+	echo "    Adding SeaBIOS CSM build to edk2"; \
+	cp $(top)/../../../elf/csmwrap/default/default/noconfig/csmwrap.efi \
+		$(EDK2_PATH)/UefiPayloadPkg/seabios.efi; \
 
 logo: $(EDK2_PATH)
 	case "$(CONFIG_EDK2_BOOTSPLASH_FILE)" in \
-- 
