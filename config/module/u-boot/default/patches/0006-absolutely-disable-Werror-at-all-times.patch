diff --git a/Makefile b/Makefile
index c8933363c5e..dec9d151103 100644
--- a/Makefile
+++ b/Makefile
@@ -542,9 +542,8 @@ UBOOTINCLUDE    := \
 
 
 KBUILD_AFLAGS   := -D__ASSEMBLY__ -fno-PIE
-KBUILD_CFLAGS   := -Wall -Werror=strict-prototypes -Wno-trigraphs \
+KBUILD_CFLAGS   := -Wall -Wno-trigraphs \
 		   -fno-strict-aliasing -fno-common -fshort-wchar -fno-PIE \
-		   -Werror=implicit-function-declaration -Werror=implicit-int \
 		   -Wno-format-security -std=gnu11 #-Wundef Enable it and fix warnings
 UBOOT_CFLAGS	:= -ffreestanding -fno-builtin
 KBUILD_CFLAGS	+= $(UBOOT_CFLAGS)
@@ -1021,9 +1020,6 @@ endif
 # Use make W=1 to enable them (see scripts/Makefile.extrawarn)
 KBUILD_CFLAGS += $(call cc-disable-warning, unused-but-set-variable)
 
-# Prohibit date/time macros, which would make the build non-deterministic
-KBUILD_CFLAGS   += $(call cc-option,-Werror=date-time)
-
 include $(srctree)/scripts/Makefile.extrawarn
 
 # Add user supplied CPPFLAGS, AFLAGS and CFLAGS as the last assignments
diff --git a/lib/lwip/lwip/contrib/ports/CMakeCommon.cmake b/lib/lwip/lwip/contrib/ports/CMakeCommon.cmake
